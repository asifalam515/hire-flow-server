generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Company {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  field       String?
  description String?
  logoUrl     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  followers   FollowedCompany[]
  jobs        Job[]
  users       User[]

  @@map("companies")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  role              Role              @default(CANDIDATE)
  isEmailVerified   Boolean           @default(false)
  otpCode           String?
  otpExpiresAt      DateTime?
  avatarUrl         String?
  companyId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  notifyAppResult   Boolean           @default(true)
  notifyMessages    Boolean           @default(true)
  notifyNewJob      Boolean           @default(true)
  candidateProfile  CandidateProfile?
  followedCompanies FollowedCompany[]
  notifications     Notification[]
  savedJobs         SavedJob[]
  sessions          Session[]
  company           Company?          @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("users")
}

model Job {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  status              JobStatus     @default(DRAFT)
  category            String
  nature              String
  vacancies           Int?
  employmentTypes     String[]
  locationCountry     String
  locationCity        String
  exactAddress        String?
  minSalary           Int
  maxSalary           Int
  isSalaryNegotiable  Boolean       @default(false)
  benefits            String[]
  educationLevel      String
  yearsOfExperience   String
  gender              String
  candidateExperience String[]
  languages           String[]
  softwareSkills      String[]
  responsibilities    String?
  requirements        String?
  companyId           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  savedJobs           SavedJob[]

  @@index([companyId])
  @@map("jobs")
}

model CandidateProfile {
  id                String                 @id @default(cuid())
  resumeUrl         String?
  parsedText        String?
  embedding         Unsupported("vector")?
  userId            String                 @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  aboutMe           String?
  city              String?
  gender            String?
  jobPreferences    Json?
  languages         String[]               @default([])
  links             Json?
  maritalStatus     String?
  mobileNumber      String?
  preferredBenefits String[]               @default([])
  skills            String[]               @default([])
  yearOfBirth       Int?
  favoriteCities    String[]               @default([])
  preferredJobTitle String?
  preferredJobTypes String[]               @default([])
  receiveEmail      Boolean                @default(true)
  tendToRemote      String?
  applications      Application[]
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations        Education[]
  workExperiences   WorkExperience[]

  @@index([userId])
  @@map("candidate_profiles")
}

model WorkExperience {
  id                 String           @id @default(cuid())
  title              String
  company            String
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  description        String?
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("work_experiences")
}

model Education {
  id                 String           @id @default(cuid())
  degree             String
  fieldOfStudy       String?
  institution        String
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("educations")
}

model Application {
  id          String            @id @default(uuid())
  status      ApplicationStatus @default(APPLIED)
  version     Int               @default(1)
  jobId       String
  candidateId String
  appliedAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews  InterviewRoom[]

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model InterviewRoom {
  id              String          @id @default(cuid())
  liveKitRoomName String          @unique
  scheduledAt     DateTime
  status          InterviewStatus @default(SCHEDULED)
  recruiterNotes  String?
  applicationId   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interview_rooms")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model FollowedCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("followed_companies")
}

enum NotificationType {
  NEW_JOB
  APPLICATION_UPDATE
  MESSAGE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fcmToken     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
